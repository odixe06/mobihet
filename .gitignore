# Cấu hình MCP cục bộ chứa bearer token Kaggle.
.mcp.json
**/.vscode/mcp.json
kaggle.json
credentials.json

# --- Python / Jupyter ---
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/

